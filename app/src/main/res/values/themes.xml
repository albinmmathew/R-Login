<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Default Application Theme (Classic Navy Material3). -->
    <style name="Base.Theme.Rlogin" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/navy_primary</item>
        <item name="colorOnPrimary">@color/navy_on_primary</item>
        <item name="colorPrimaryContainer">@color/navy_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/navy_on_primary_container</item>

        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#002868</item>
        <item name="colorSurfaceVariant">#F0F4F8</item>
        <item name="colorOnSurfaceVariant">#555555</item>
        <item name="colorOutline">#2B002868</item>
        <item name="colorOutlineVariant">#18002868</item>

        <!-- Status Bar Configuration -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Rlogin" parent="Base.Theme.Rlogin" />
    <style name="Theme.Rlogin.Default" parent="Base.Theme.Rlogin" />

    <!-- Brutalist Application Theme (Paros Neo-Brutalist). -->
    <style name="Theme.Rlogin.Brutalist" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/neo_bg</item>
        <item name="colorPrimary">@color/neo_brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/neo_yellow</item>
        <item name="colorOnPrimaryContainer">@color/neo_ink</item>

        <item name="colorSurface">@color/neo_bg</item>
        <item name="colorOnSurface">@color/neo_ink</item>
        <item name="colorSurfaceVariant">@color/neo_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/neo_muted</item>
        <item name="colorOutline">@color/neo_ink</item>
        <item name="colorOutlineVariant">@color/neo_ink</item>

        <!-- Status Bar Configuration -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/neo_bg</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Overflow Button & Popup Menu Styling -->
        <item name="actionOverflowButtonStyle">@style/Widget.Neo.OverflowButton</item>
        <item name="android:actionOverflowButtonStyle">@style/Widget.Neo.OverflowButton</item>
        <item name="popupMenuStyle">@style/Widget.Neo.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Neo.PopupMenu</item>
    </style>

    <!-- Alias Custom theme to Brutalist -->
    <style name="Theme.Rlogin.Custom" parent="Theme.Rlogin.Brutalist" />

    <style name="Widget.Neo.OverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/neo_ink</item>
        <item name="tint">@color/neo_ink</item>
    </style>

    <style name="Widget.Neo.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_neo_popup</item>
        <item name="android:textColor">@color/neo_ink</item>
    </style>

    <style name="ThemeOverlay.Neo.PopupMenu" parent="ThemeOverlay.Material3">
        <item name="android:colorBackground">@color/neo_surface</item>
        <item name="colorSurface">@color/neo_surface</item>
        <item name="colorOnSurface">@color/neo_ink</item>
        <item name="android:textColor">@color/neo_ink</item>
        <item name="android:popupBackground">@drawable/bg_neo_popup</item>
        <item name="popupMenuStyle">@style/Widget.Neo.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Neo.PopupMenu</item>
    </style>
</resources>
