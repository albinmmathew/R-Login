<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/neo_bg">

    <!-- Neo-Brutalist Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neo_header"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="LMS ASSIGNMENTS"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/neo_ink"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/neo_ink" />
    </LinearLayout>

    <!-- Filter Segment Group -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="@color/neo_bg">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neo_shadow_wrapper">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/filter_toggle_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_pending"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="PENDING (0)"
                    app:backgroundTint="@color/sel_neo_toggle_bg"
                    android:textColor="@color/sel_neo_toggle_text"
                    app:strokeColor="@color/neo_ink"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"
                    app:rippleColor="#33000000" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_overdue"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="OVERDUE (0)"
                    app:backgroundTint="@color/sel_neo_toggle_bg"
                    android:textColor="@color/sel_neo_toggle_text"
                    app:strokeColor="@color/neo_ink"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"
                    app:rippleColor="#33000000" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_completed"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="COMPLETED (0)"
                    app:backgroundTint="@color/sel_neo_toggle_bg"
                    android:textColor="@color/sel_neo_toggle_text"
                    app:strokeColor="@color/neo_ink"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"
                    app:rippleColor="#33000000" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </FrameLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Pull to refresh wrapper -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="16dp"
                android:scrollbars="none" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Loading State View -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/neo_brand" />

            <TextView
                android:id="@+id/txt_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:text="SCRAPING MOODLE SESSIONS..."
                android:textColor="@color/neo_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_neo_icon_box">

                <ImageView
                    android:id="@+id/img_empty"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    app:tint="#FFFFFF"
                    android:contentDescription="Empty" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03"
                android:text="ALL CAUGHT UP!"
                android:textColor="@color/neo_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="NO PENDING ASSIGNMENTS"
                android:textColor="@color/neo_muted"
                android:textSize="12sp"
                android:textAlignment="center" />
        </LinearLayout>

    </FrameLayout>

    <!-- Hidden WebView for background Moodle session & scraping -->
    <WebView
        android:id="@+id/hidden_web_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
