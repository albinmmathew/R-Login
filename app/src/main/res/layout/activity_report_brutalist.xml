<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/neo_bg">

    <!-- Neo-Brutalist Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neo_header"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="CONSOLIDATED ATTENDANCE"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/neo_ink"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/neo_ink" />
    </LinearLayout>

    <!-- Sticky Segmented Control Bar -->
    <LinearLayout
        android:id="@+id/toggle_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/neo_bg">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neo_shadow_wrapper">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btn_with_od">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_with_od"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="WITH OD"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/sel_neo_toggle_bg"
                    android:textColor="@color/sel_neo_toggle_text"
                    app:strokeColor="@color/neo_ink"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"
                    app:rippleColor="#33000000" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_without_od"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="WITHOUT OD"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/sel_neo_toggle_bg"
                    android:textColor="@color/sel_neo_toggle_text"
                    app:strokeColor="@color/neo_ink"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"
                    app:rippleColor="#33000000" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </FrameLayout>
    </LinearLayout>

    <!-- Loading State -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/neo_brand"
        android:layout_marginTop="64dp" />

    <TextView
        android:id="@+id/txt_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="16dp"
        android:text="FETCHING ATTENDANCE FROM FEDENA..."
        android:textColor="@color/neo_ink"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <!-- Attendance RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone" />

    <!-- Hidden WebView for Scraping -->
    <WebView
        android:id="@+id/hidden_web_view"
        android:layout_width="0dp"
        android:layout_height="0dp" />

</LinearLayout>
