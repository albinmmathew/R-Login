<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/neo_bg">

    <!-- Paros Style Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neo_header"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            app:title=""
            app:popupTheme="@style/ThemeOverlay.Neo.PopupMenu">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Logo Tile (Orange Square + White R) -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_neo_icon_box">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:text="R"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Wordmark -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:text="R-LOGIN"
                        android:textColor="@color/neo_ink"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="."
                        android:textColor="@color/neo_brand"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- M-WiFi Card (Mint Tint) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_neo_card_mint">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Icon Container -->
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_neo_icon_box">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="WiFi"
                                android:src="@drawable/ic_wifi"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.03"
                                android:text="M-WIFI PORTAL"
                                android:textColor="@color/neo_ink"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/status_wifi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="NOT CONFIGURED"
                                android:textColor="@color/neo_muted"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Edit Button (Neo Chip) -->
                        <ImageButton
                            android:id="@+id/btn_edit_wifi"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_neo_btn_secondary"
                            android:contentDescription="Edit WiFi"
                            android:padding="8dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/neo_ink" />
                    </LinearLayout>

                    <!-- Dashed Divider -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:layerType="software"
                        android:src="@drawable/bg_neo_divider_dashed" />

                    <!-- Primary Connect Button -->
                    <Button
                        android:id="@+id/c_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_neo_btn_primary"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:text="CONNECT TO M-WIFI →"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Fedena Card (Cream / Yellow Tint) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_neo_card_yellow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_neo_icon_box">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="Fedena"
                                android:src="@drawable/ic_school"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.03"
                                android:text="FEDENA PORTAL"
                                android:textColor="@color/neo_ink"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/status_fedena"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="NOT CONFIGURED"
                                android:textColor="@color/neo_muted"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btn_edit_fedena"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_neo_btn_secondary"
                            android:contentDescription="Edit Fedena"
                            android:padding="8dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/neo_ink" />
                    </LinearLayout>

                    <!-- Dashed Divider -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:layerType="software"
                        android:src="@drawable/bg_neo_divider_dashed" />

                    <!-- Two Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/c_fedena"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_neo_btn_secondary"
                            app:backgroundTint="@null"
                            android:stateListAnimator="@null"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.03"
                            android:text="OPEN ↗"
                            android:textColor="@color/neo_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/r_fedena"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/bg_neo_btn_green"
                            app:backgroundTint="@null"
                            android:stateListAnimator="@null"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.03"
                            android:text="ATTENDANCE"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- LMS Card (Peach Tint) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_neo_card_peach">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_neo_icon_box">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="LMS"
                                android:src="@drawable/ic_book"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.03"
                                android:text="LMS MOODLE"
                                android:textColor="@color/neo_ink"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/status_lms"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="NOT CONFIGURED"
                                android:textColor="@color/neo_muted"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btn_edit_lms"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_neo_btn_secondary"
                            android:contentDescription="Edit LMS"
                            android:padding="8dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/neo_ink" />
                    </LinearLayout>

                    <!-- Dashed Divider -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:layerType="software"
                        android:src="@drawable/bg_neo_divider_dashed" />

                    <!-- Two Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/c_lms"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_neo_btn_secondary"
                            app:backgroundTint="@null"
                            android:stateListAnimator="@null"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.03"
                            android:text="OPEN ↗"
                            android:textColor="@color/neo_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/r_lms"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/bg_neo_btn_primary"
                            app:backgroundTint="@null"
                            android:stateListAnimator="@null"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.03"
                            android:text="ASSIGNMENTS"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
