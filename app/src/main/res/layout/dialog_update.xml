<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neo_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/icon_tile"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_neo_icon_box">

                    <ImageView
                        android:id="@+id/img_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Dialog Icon"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_dialog_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.03"
                        android:text="SYSTEM UPDATES"
                        android:textColor="@color/neo_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Version Badges -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/badge_current_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_neo_pill_yellow"
                            android:fontFamily="monospace"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            tools:text="v3.0.0"
                            android:textColor="@color/neo_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badge_latest_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_neo_pill_mint"
                            android:fontFamily="monospace"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="LATEST"
                            android:textColor="@color/neo_ink"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Dashed Divider -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:layerType="software"
                android:src="@drawable/bg_neo_divider_dashed" />

            <!-- Progress Bar for Checking State -->
            <ProgressBar
                android:id="@+id/progress_checking"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:indeterminateTint="@color/neo_brand" />

            <!-- Status Text Message -->
            <TextView
                android:id="@+id/txt_status_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:text="CHECKING GITHUB RELEASES..."
                android:textColor="@color/neo_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Changelog Container (Scrollable) -->
            <ScrollView
                android:id="@+id/scroll_changelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_changelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/neo_ink"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </ScrollView>

            <!-- Dashed Divider -->
            <ImageView
                android:id="@+id/divider_bottom"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layerType="software"
                android:src="@drawable/bg_neo_divider_dashed" />

            <!-- Buttons Row -->
            <LinearLayout
                android:id="@+id/layout_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_negative"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_neo_btn_secondary"
                    app:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.03"
                    android:text="CLOSE"
                    android:textColor="@color/neo_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_positive"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_neo_btn_primary"
                    app:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.03"
                    android:text="DOWNLOAD →"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
